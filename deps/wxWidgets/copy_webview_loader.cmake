file(GLOB loaders "${WX_BUILD_DIR}/lib/*/WebView2Loader.dll")
list(LENGTH loaders loader_count)
if(NOT loader_count EQUAL 1)
    message(FATAL_ERROR "Expected one wxWidgets WebView2Loader.dll, found ${loader_count}")
endif()
file(MAKE_DIRECTORY "${DESTDIR}/bin")
file(COPY ${loaders} DESTINATION "${DESTDIR}/bin")
file(GLOB sdk_dirs "${WX_BUILD_DIR}/libs/webview/packages/Microsoft.Web.WebView2.*")
list(LENGTH sdk_dirs sdk_count)
if(NOT sdk_count EQUAL 1)
    message(FATAL_ERROR "Expected one WebView2 SDK package, found ${sdk_count}")
endif()
file(MAKE_DIRECTORY "${DESTDIR}/share/licenses/Microsoft.WebView2")
file(COPY "${sdk_dirs}/LICENSE.txt" "${sdk_dirs}/NOTICE.txt"
    DESTINATION "${DESTDIR}/share/licenses/Microsoft.WebView2")
