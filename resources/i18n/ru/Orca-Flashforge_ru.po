msgid "Submit"
msgstr "Отправить"

msgid "Report submitted"
msgstr "Отчет отправлен"

msgid "C5 or C5P Not Connected"
msgstr "C5 или C5P не подключены"

msgid "Smart Remapping"
msgstr "Умное сопоставление"

msgid "Hardware Mapping"
msgstr "Аппаратное сопоставление"

