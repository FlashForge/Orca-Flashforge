msgid ""
"Bed temperature for layers except the initial one. A value of 0 means the "
"filament does not support printing on the Textured PEI Plate."
msgstr ""
"Температура стола для всех слоев, кроме начального. Значение 0 означает, что "
"филамент не поддерживает печать на платформе Textured PEI Plate."

msgid "First layer"
msgstr "Первый слой"

msgid "First layer bed temperature"
msgstr "Температура стола для первого слоя"

msgid ""
"Bed temperature of the first layer. A value of 0 means the filament does not "
"support printing on the Cool Plate SuperTack."
msgstr ""
"Температура стола для первого слоя. Значение 0 означает, что филамент не "
"поддерживает печать на платформе Cool Plate SuperTack."

msgid ""
"Bed temperature of the first layer. A value of 0 means the filament does not "
"support printing on the Cool Plate."
msgstr ""
"Температура стола для первого слоя. Значение 0 означает, что филамент не "
"поддерживает печать на платформе Cool Plate."

msgid ""
"Bed temperature of the first layer. A value of 0 means the filament does not "
"support printing on the Textured Cool Plate."
msgstr ""
"Температура стола для первого слоя. Значение 0 означает, что филамент не "
"поддерживает печать на платформе Textured Cool Plate."

msgid ""
"Bed temperature of the first layer. A value of 0 means the filament does not "
"support printing on the Engineering Plate."
msgstr ""
