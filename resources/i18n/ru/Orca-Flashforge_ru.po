msgid "Plate"
msgstr "Стол"

msgctxt "Flashforge"
msgid "Original"
msgstr "Оригинал"

msgid "Issue Feedback"
msgstr "Отзыв о проблеме"

msgid "Feature Request"
msgstr "Запрос функции"

msgid "The feedback has been received and will be processed as soon as possible."
msgstr "Обратная связь получена и будет обработана в кратчайшие сроки."

msgid "The feedback has been received."
msgstr "Обратная связь получена."

msgid "This will prevent data from being transmitted to cloud services. Users who only utilize local network functionality can safely enable this option."
msgstr "Это предотвратит передачу данных в облачные сервисы. Пользователи, использующие только функции локальной сети, могут безопасно включить эту опцию."

msgid "%s devices require an update. Please upgrade %s to %s or later, then upgrade again to %s or later. Devices with versions below %s will not be able to connect properly."
msgstr "Для %s устройств требуется обновление. Обновите %s до версии %s или более поздней, затем обновите еще раз до версии %s или более поздней. Устройства с версиями ниже %s не смогут подключиться должным образом."

msgid "%s devices require an update. Please upgrade %s, and the remaining %d devices to %s or later, then upgrade again to %s or later. Devices with versions below %s will not be able to connect properly."
msgstr "Для %s устройств требуется обновление. Обновите %s и остальные устройства %d до версии %s или более поздней, а затем обновите еще раз до версии %s или более поздней. Устройства с версиями ниже %s не смогут подключиться должным образом."

msgid "Device Info"
msgstr "Сведения об устройстве"

msgid "Edit or load filament after selecting an extruder"
msgstr "Изменить или загрузить филамент после выбора экструдера"

msgid "Email Address"
msgstr "E-mail"

msgid "Email cannot be empty."
msgstr "Адрес электронной почты не может быть пустым."

msgid "Extruder & Filament"
msgstr "Экструдер и филамент"

msgid "Flash Studio is based on OrcaSlicer by Softfever, and OrcaSlicer is based on BambuStudio by Bambulab, which is from PrusaSlicer by Prusa Research.  PrusaSlicer is from Slic3r by Alessandro Ranellucci and the RepRap community"
msgstr "ПО Flash Studio основано на ПО OrcaSlicer от Softfever, а ПО OrcaSlicer основано на ПО BambuStudio от Bambulab, которое является продуктом PrusaSlicer от Prusa Research.  ПО PrusaSlicer от компании Slic3r разработано Алессандро Ранеллуччи (Alessandro Ranellucci) совместно с сообществом RepRap."

msgid "Free Regenerations Left: %d"
msgstr "Осталось свободных регенераций: %d"

msgid "Full Power! Create Now!"
msgstr "Полный ход! Создать сейчас!"

msgid "Generating local device id"
msgstr "Генерирование локального идентификатора устройства"

msgid "If you cannot detect the new version, you can actively download it via the following link:"
msgstr "Если вы не можете обнаружить новую версию, ее можно загрузить по следующей ссылке:"

msgid "Motion Mode (140%)"
msgstr "Режим движения (140%)"

msgid "Please also upgrade the mobile app to the latest version to ensure its normal use."
msgstr "Также обновите мобильное приложение до последней версии, чтобы обеспечить его нормальное использование."

msgid "Print Inspection"
msgstr "Проверка печати"

msgid "Save tmp zip file"
msgstr "Сохранить zip-файл в формате tmp"

msgid "Select an extruder to edit"
msgstr "Выбрать экструдер для редактирования"

msgid "Silent Mode (50%)"
msgstr "Тихий режим (50%)"

msgid "Standard Mode (100%)"
msgstr "Стандартный режим (100%)"

msgid "Temperature & Control"
msgstr "Температура и управление"

msgid "The equipment needs to be updated. Please update the printer versions. The following printer versions require updating to ensure proper operation:"
msgstr "Необходимо обновить оборудование. Обновите версии принтеров. Для обеспечения правильной работы необходимо обновить следующие версии принтеров:"

msgid "This will use 1 free regeneration. Continue?"
msgstr "Для этого будет использована 1 бесплатная регенерация. Продолжить?"

msgid "Upload Complete"
msgstr "Загрузка завершена"

msgid "Upload Successful"
msgstr "Загрузка прошла успешно"

msgid "Upload failed"
msgstr "Ошибка загрузки"

msgid "No camera detected"
msgstr "Камера не обнаружена"

msgid "Repairing polygon soup"
msgstr "Исправление полигональных данных"

msgid "Orienting polygon soup"
msgstr "Ориентация полигональных данных"

msgid "Converting to mesh"
msgstr "Преобразование в сетку"

msgid "Repairing mesh boundaries"
msgstr "Исправление границ сетки"

msgid "Finalizing repaired mesh"
msgstr "Завершение исправленной сетки"

msgid "Remapping repaired mesh colors"
msgstr "Переназначение цветов исправленной сетки"
