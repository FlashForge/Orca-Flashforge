msgstr "Загрузка пользовательского G-кода из файла json."

msgid "Load filament IDs"
msgstr "Загрузка идентификаторов филаментов"

msgid "Load filament IDs for each object."
msgstr "Загрузка идентификаторов филаментов для каждого объекта."

msgid "Allow multiple colors on one plate"
msgstr "Разрешить использование нескольких цветов на одной платформе"

msgid "If enabled, Arrange will allow multiple colors on one plate."
msgstr ""
"Если функция Arrange включена, то на одной платформе можно печатать "
"несколько цветов."

msgid "Allow rotation when arranging"
msgstr "Разрешить поворот при компоновке"

msgid "If enabled, Arrange will allow rotation when placing objects."
msgstr ""
