msgid "Original"
msgstr "Оригинал"

msgid "Issue Feedback"
msgstr "Отзыв о проблеме"

msgid "Feature Request"
msgstr "Запрос функции"

msgid "The feedback has been received and will be processed as soon as possible."
msgstr "Обратная связь получена и будет обработана в кратчайшие сроки."

msgid "The feedback has been received."
msgstr "Обратная связь получена."

msgid "This will prevent data from being transmitted to cloud services. Users who only utilize local network functionality can safely enable this option."
msgstr "Это предотвратит передачу данных в облачные сервисы. Пользователи, использующие только функции локальной сети, могут безопасно включить эту опцию."

msgid "%s devices require an update. Please upgrade %s to %s or later, then upgrade again to %s or later. Devices with versions below %s will not be able to connect properly."
msgstr "Для %s устройств требуется обновление. Обновите %s до версии %s или более поздней, затем обновите еще раз до версии %s или более поздней. Устройства с версиями ниже %s не смогут подключиться должным образом."

msgid "%s devices require an update. Please upgrade %s, and the remaining %d devices to %s or later, then upgrade again to %s or later. Devices with versions below %s will not be able to connect properly."
msgstr "Для %s устройств требуется обновление. Обновите %s и остальные устройства %d до версии %s или более поздней, а затем обновите еще раз до версии %s или более поздней. Устройства с версиями ниже %s не смогут подключиться должным образом."

msgid "Device Info"
msgstr "Сведения об устройстве"

msgid "Edit or load filament after selecting an extruder"
msgstr "Изменить или загрузить филамент после выбора экструдера"

msgid "Email Address"
msgstr "E-mail"

msgid "Email cannot be empty."
msgstr "Адрес электронной почты не может быть пустым."

