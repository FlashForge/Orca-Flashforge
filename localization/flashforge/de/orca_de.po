msgstr "Direkter Mehrfarben-Local-Z-Löser: %s"

msgid "Carry-over error is distributed directly across all %d components instead of collapsing them into pair cadence."
msgstr "Der Fehlerübertrag wird direkt über alle %d Komponenten verteilt, statt in eine Paar-Kadenz reduziert zu werden."

msgid "Effective Local-Z cap: up to %d sublayers per nominal layer."
msgstr "Effektive Local-Z-Grenze: bis zu %d Unterschichten pro nomineller Schicht."

msgid "Local-Z layer cadence: %s."
msgstr "Local-Z-Schichtkadenz: %s."

msgid "Pair splits: %s."
msgstr "Paaraufteilungen: %s."

msgid "Saved row limit will apply when Local-Z dithering mode is enabled in print settings."
msgstr "Das gespeicherte Zeilenlimit gilt, wenn der Local-Z-Dithering-Modus in den Druckeinstellungen aktiviert ist."

msgid "Effective Local-Z stack: %d sublayers over %d pair layers."
msgstr "Effektiver Local-Z-Stapel: %d Unterschichten über %d Paarschichten."

msgid "Effective Local-Z stack: %d sublayers over %d pair layers (uncapped %d)."
msgstr "Effektiver Local-Z-Stapel: %d Unterschichten über %d Paarschichten (unbegrenzt %d)."

